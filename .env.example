PAYLOAD_SECRET=mygeneratedsecret
DATABASE_URL=postgresql://127.0.0.1:5432/template-ecommerce?sslmode=verify-full

COMPANY_NAME="Payload Inc."
COMPANY_GST="[GST NO]"
COMPANY_ADDRESS="[ADDRESS]"
TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="Payload Commerce"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
DOMAIN_NAME=

# Cloudflare Turnstile (required for career applications)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostHog analytics and session replay
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://phg.honeylooms.in
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# Set to false to hide the built-in SVG hero when no active CMS banner exists.
ENABLE_SVG_HOMEPAGE_BANNER=true

# Cloudflare R2 media storage
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<bucket-subdomain>.r2.dev/<bucket-name>

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Cashfree API keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# SMTP configuration for invoice emails
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=info@honeylooms.com
SMTP_FROM_NAME=Honeylooms
ADMIN_EMAIL_NOTIFICATIONS="admin1@example.com,admin2@example.com"
